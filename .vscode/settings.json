{
  // ── 通用：LaTeX Workshop 行为（三平台共用） ──
  // 保存时自动编译
  "latex-workshop.latex.autoBuild.run": "onSave",
  // 内置 PDF 预览（VS Code 标签页，无需额外阅读器）
  "latex-workshop.view.pdf.viewer": "tab",
  // 手动“Clean up”时清理的中间文件
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux",
    "*.bbl",
    "*.blg",
    "*.idx",
    "*.ind",
    "*.lof",
    "*.lot",
    "*.out",
    "*.toc",
    "*.log",
    "*.fls",
    "*.fdb_latexmk",
    "*.xdv",
    "*.bcf",
    "*.run.xml",
    "*.synctex.gz",
    "*.synctex(busy)",
    "*-converted-to.*"
  ],
  "latex-workshop.latex.autoBuild.cleanAndRetry.enabled": false,

  // ── macOS（保留原配置，不影响 Mac 端） ──
  // 英文定稿版（pdflatex）：如需中文版，把 command 换成 latexmk -xelatex 即可。
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk (pdflatex)",
      "command": "/Library/TeX/texbin/latexmk",
      "args": [
        "-pdf",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-cd",
        "%DOC%"
      ],
      "env": {
        "PATH": "/Library/TeX/texbin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin"
      }
    }
  ],
  "latex-workshop.latex.recipes": [
    { "name": "latexmk (pdflatex)", "tools": ["latexmk (pdflatex)"] }
  ],

  // ── Windows（本机：TeX Live 2026 默认安装到 C:\texlive\2026） ──
  // VS Code 1.80+ 支持这种按平台覆盖的写法：Windows 上使用下面的
  // tools / recipes，macOS / Linux 继续使用上面的配置。
  // TeX Live 未加入系统 PATH，所以命令必须写绝对路径。
  "windows": {
    "latex-workshop.latex.recipe.default": "first",
    "latex-workshop.latex.tools": [
      {
        // 首选：latexmk 自动完成 xelatex → bibtex → xelatex×2
        "name": "latexmk (xelatex)",
        "command": "C:\\texlive\\2026\\bin\\windows\\latexmk.exe",
        "args": [
          "-xelatex",
          "-synctex=1",
          "-interaction=nonstopmode",
          "-file-line-error",
          "-cd",
          "%DOC%"
        ],
        "env": {
          "PATH": "C:\\texlive\\2026\\bin\\windows;C:\\Windows\\system32;C:\\Windows;C:\\Windows\\System32\\Wbem;C:\\Windows\\System32\\WindowsPowerShell\\v1.0"
        }
      },
      {
        "name": "xelatex",
        "command": "C:\\texlive\\2026\\bin\\windows\\xelatex.exe",
        "args": [
          "-synctex=1",
          "-interaction=nonstopmode",
          "-file-line-error",
          "%DOCFILE%"
        ]
      },
      {
        "name": "bibtex",
        "command": "C:\\texlive\\2026\\bin\\windows\\bibtex.exe",
        "args": [
          "%DOCFILE%"
        ]
      },
      {
        "name": "latexmk (pdflatex)",
        "command": "C:\\texlive\\2026\\bin\\windows\\latexmk.exe",
        "args": [
          "-pdf",
          "-synctex=1",
          "-interaction=nonstopmode",
          "-file-line-error",
          "-cd",
          "%DOC%"
        ],
        "env": {
          "PATH": "C:\\texlive\\2026\\bin\\windows;C:\\Windows\\system32;C:\\Windows;C:\\Windows\\System32\\Wbem;C:\\Windows\\System32\\WindowsPowerShell\\v1.0"
        }
      },
      {
        "name": "pdflatex",
        "command": "C:\\texlive\\2026\\bin\\windows\\pdflatex.exe",
        "args": [
          "-synctex=1",
          "-interaction=nonstopmode",
          "-file-line-error",
          "%DOCFILE%"
        ]
      }
    ],
    "latex-workshop.latex.recipes": [
      {
        // 默认 recipe：支持 ctex 中文，自动处理参考文献
        "name": "XeLaTeX (latexmk)",
        "tools": ["latexmk (xelatex)"]
      },
      {
        "name": "XeLaTeX -> BibTeX -> XeLaTeX*2",
        "tools": ["xelatex", "bibtex", "xelatex", "xelatex"]
      },
      {
        // 英文定稿、去掉 ctex 后可用
        "name": "PDFLaTeX (latexmk)",
        "tools": ["latexmk (pdflatex)"]
      }
    ]
  }
}
